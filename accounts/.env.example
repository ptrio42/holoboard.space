# Separate secrets, never use the relay's identity or receiving-wallet credentials.
KEYCAST_SOURCE=../output/keycast/source
KEYCAST_DB_PASSWORD=
KEYCAST_SECRETS_FILE=
KEYCAST_MASTER_KEY_FILE=
KEYCAST_BUNKER_RELAYS=
KEYCAST_ALLOWED_ORIGINS=https://holoboard.example,https://accounts.holoboard.example
KEYCAST_TENANT_DOMAINS=accounts.holoboard.example
KEYCAST_PUBLIC_URL=https://accounts.holoboard.example
KEYCAST_PORT=3100
KEYCAST_ENVIRONMENT=production
KEYCAST_FROM_EMAIL=noreply@example.invalid
