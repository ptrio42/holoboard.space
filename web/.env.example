# The holoboard relay. Serves the ranked board.
VITE_RELAY_URL=wss://relay.holoboard.space

# Optional HTTP API origin, independent of the Nostr WebSocket relay.
# For a local backend with external Nostr relays: http://127.0.0.1:3334
VITE_API_URL=

# The relay's own pubkey. Promotions are mentions of, and zaps to, this key.
VITE_RELAY_PUBKEY=30bd172fc5295108b93de95516c811fabcfba0ec891e251645023329113d7643

# Public relays used for profiles, promotion mentions and zap receipts.
# The holoboard relay itself rejects anything that has not been paid for.
VITE_PUBLIC_RELAYS=wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net,wss://nostr.mom,wss://offchain.pub

# Where the relay serves its payment ledger. Defaults to RELAY_URL over plain
# HTTP with /api/board on the end, which is where the relay puts it.
VITE_SATS_ENDPOINT=

# Hold signer UI and remote-signer restoration for a later release.
VITE_ENABLE_NOSTR_CONNECT=false

# Opt-in read-only discussion screen. Does not enable signers or publishing.
VITE_ENABLE_DISCUSSIONS=false

# Opt-in read-only profile screens.
VITE_ENABLE_PROFILES=false

# Opt-in reply editor, also requires discussions and Nostr Connect above.
VITE_ENABLE_REPLY_PUBLICATION=false

# Enable only after registering the production origin at gifs.nostr.build.
# Localhost GIF search works without this flag.
VITE_ENABLE_GIF_SEARCH=false

# Independent opt-in gates. Existing issued invoices continue on the backend.
VITE_ENABLE_POST_CREATION=false
VITE_ENABLE_EMAIL_ACCOUNTS=false
# Isolated Holoboard-owned Keycast origin, without a trailing path.
VITE_KEYCAST_URL=
VITE_KEYCAST_CLIENT_ID=holoboard
