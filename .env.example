# Settings for Docker Compose. Copy this file to .env in the project folder.
# Generate a matching pair with:
# docker compose run --rm --no-deps relay /app/keygen
RELAY_PRIVKEY=
VITE_RELAY_PUBKEY=

# Local website address. If you change WEB_PORT, update VITE_RELAY_URL too.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
VITE_RELAY_URL=ws://localhost:8080/relay
VITE_BOARD_LIMIT=50
# Included in the account quote published after a note's first paid promotion.
# Set this to the public HTTPS address before exposing the board to the internet.
PUBLIC_BOARD_URL=http://localhost:8080

# mock is for trying the app. It does not accept real payments.
# To receive sats, set LIGHTNING_BACKEND=nwc and paste your wallet connection.
LIGHTNING_BACKEND=mock
NWC_URI=

# Use the same public relays for the frontend and the relay's subscriptions.
FETCH_RELAYS=wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net,wss://nostr.mom,wss://offchain.pub
DEFAULT_PAYMENT_SATS=1000
INVOICE_CHECK_SECONDS=60
RELAY_DESCRIPTION="A bulletin board where the order is decided by sats, with recent sats counting for more. Visit https://holoboard.space"

# Optional operator settings.
ADMIN_PUBKEY=
ADMIN_TOKEN=
