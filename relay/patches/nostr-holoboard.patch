+					return
+				}
+			}
+		})
+		relay, err := RelayConnect(context.Background(), url)
+		if err != nil {
+			t.Fatal(err)
+		}
+		relays = append(relays, relay)
+		t.Cleanup(func() { relay.Close() })
+		if i == 6 {
