+			}
+			subscriptions = append(subscriptions, sub)
+		}
+	}
+	if sub, err := relays[6].Subscribe(context.Background(), Filter{}, SubscriptionOptions{}); err == nil || sub != nil {
+		t.Fatal("global subscription cap missing")
+	}
