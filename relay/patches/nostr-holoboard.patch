+	replacement, err := relays[6].Subscribe(context.Background(), Filter{}, SubscriptionOptions{})
+	if err != nil {
+		t.Fatal("global slot not released", err)
+	}
+	replacement.Unsub()
+	for _, sub := range subscriptions {
+		sub.Unsub()
+	}
+}
