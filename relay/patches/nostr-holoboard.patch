+func TestHoloboardGlobalSubscriptionAdmission(t *testing.T) {
+	var relays []*Relay
+	var subscriptions []*Subscription
+	for i := 0; i < 7; i++ {
+		url := regressionRelay(t, func(conn *websocket.Conn) {
+			for {
