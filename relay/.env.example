# Relay Configuration
RELAY_PRIVKEY=your_private_key_here_in_hex_format

# Lightning Backend Configuration
# Choose your Lightning backend: mock, nwc, lnbits, zebedee
LIGHTNING_BACKEND=mock

# For NWC (Nostr Wallet Connect, NIP-47) - works with any NWC wallet:
# Paste the connection string your wallet gives you. NWC sits between this
# relay and its own wallet; whoever pays still just pays an ordinary bolt11.
# nostr+walletconnect://<wallet-pubkey>?relay=<wss url>&secret=<hex>&lud16=<address>
NWC_URI=

# For Zebedee:
ZEBEDEE_API_KEY=your_zebedee_api_key_here
# Optional: Webhook URL for payment notifications
ZEBEDEE_WEBHOOK_URL=https://your-relay.com/webhook/zebedee

# For LNbits (free, no-KYC option):
# Get your keys from your LNbits wallet > API Info
LNBITS_API_KEY=your_lnbits_invoice_key_here
LNBITS_READ_KEY=your_lnbits_read_key_here
# Optional: Use your own LNbits instance (default: https://legend.lnbits.com)
LNBITS_BASE_URL=https://legend.lnbits.com

# For LND (production):
# LND_ADDRESS=localhost:10009
# LND_TLS_CERT=/path/to/tls.cert
# LND_MACAROON=/path/to/admin.macaroon

# Lightning addresses this relay collects zaps on, comma separated.
#
# A zap receipt is only believable if it was signed by the nostr key of the
# LNURL server behind the address the money went to. Leave this empty and the
# relay uses the lud16 from its own kind:0 profile, plus the NWC wallet's
# address when that differs. With no address resolvable, every zap is refused.
ZAP_LNURL_ADDRESSES=

# Relay Settings
# How often to re-check invoices we are still waiting on. This is what settles
# invoices paid while the relay was down, and the backstop for wallets that
# push no payment notifications.
INVOICE_CHECK_SECONDS=60
PORT=3334
DEFAULT_PAYMENT_SATS=1000
DATA_FILE=relay_data.json

# Fetch Relays (comma-separated) - used to fetch posts AND monitor for zaps
FETCH_RELAYS=wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net,wss://nostr.mom,wss://offchain.pub

# Taking a note off the board. Both are optional and independent; without
# either, nothing can be removed and the relay says so at startup.
#
# ADMIN_PUBKEY is the one key allowed to send REMOVE and RESTORE as a direct
# message. npub or hex. The sender is established from the signature on the
# NIP-59 seal, not from anything the message claims.
ADMIN_PUBKEY=
# ADMIN_TOKEN is the same power over HTTP, for when the key is not to hand.
# Unset means the route is not registered at all rather than left unguarded.
ADMIN_TOKEN=
