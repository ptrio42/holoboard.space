<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>space.holoboard.curator</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>/absolute/private/holoboard-curator/runner.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/absolute/private/holoboard-curator/runner.log</string>
  <key>StandardErrorPath</key><string>/absolute/private/holoboard-curator/runner-error.log</string>
</dict>
</plist>
