# Copy outside the repository, set mode 0600, and load explicitly in a trusted operator shell.
# This example is not read automatically by the runner.
CURATOR_BACKEND_URL=http://127.0.0.1:3334
CURATOR_TOKEN=replace-with-a-dedicated-backend-curator-bearer
CURATOR_STATE_PATH=/absolute/path/to/holoboard/curator/.state/state.json
CURATOR_CODEX_BIN=/absolute/path/to/codex
# Keep false until the operator verifies auto-reload and applicable overage billing are disabled.
# Native confirmation of no available credits is additionally required before every evaluation.
CURATOR_CHATGPT_OVERAGE_DISABLED=false
# Optional native auth home already signed in with ChatGPT. No API keys.
# CURATOR_CODEX_AUTH_HOME=/absolute/private/native-codex-auth
# Optional existing slug from this CLI's bundled catalog; otherwise native default.
# CURATOR_CODEX_MODEL=an-existing-bundled-model-slug
