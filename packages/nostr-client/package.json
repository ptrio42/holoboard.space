    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.10.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "vite": "7.3.7",
    "tailwindcss": "4.1.18",
    "@tailwindcss/node": "4.1.18",
    "@tailwindcss/oxide": "4.1.18",
    "postcss": "8.5.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@playwright/test": "1.63.0"
  }
